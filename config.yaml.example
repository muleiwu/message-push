# 服务器配置
# 注意：应用访问地址（用于生成回调URL等）会自动从请求中获取，无需配置
server:
  mode: release  # debug, release, test
  addr: ":8080"

# HTTP 服务配置
http:
  load_static: false
  static_mode: embed  # disk 或 embed
  static_dir: []

# 数据库配置
database:
  halt_on_migration_failure: true
  host: localhost
  port: 3306
  username: root
  password: password
  database: dwz_db
  charset: utf8mb4
  parse_time: true
  loc: Local
  max_idle_conns: 10
  max_open_conns: 100
  conn_max_lifetime: 3600

# PostgreSQL 配置（可选）
# postgres:
#   host: localhost
#   port: 5432
#   username: postgres
#   password: password
#   database: dwz_db
#   sslmode: disable

# Redis 配置
redis:
  host: localhost
  port: 6379
  password: ""
  db: 0
  pool_size: 10
  min_idle_conns: 5

# 日志配置
log:
  level: info    # debug, info, warn, error
  filename: logs/app.log
  max_size: 100     # MB
  max_age: 30       # days
  max_backups: 10
  compress: true

# JWT 配置（管理后台认证使用）
# 环境变量：JWT_SECRET / JWT_EXPIRE_HOURS；多副本部署必须显式设置且各副本一致
jwt:
  secret: your-secret-key-change-in-production
  expire_hours: 24

# OIDC SSO 登录（管理后台，可选）
# 环境变量：OIDC_ENABLED / OIDC_ISSUER / OIDC_CLIENT_ID / OIDC_CLIENT_SECRET /
#          OIDC_REDIRECT_URL / OIDC_SCOPES / OIDC_DISPLAY_NAME / OIDC_FRONTEND_CALLBACK
# 注意：issuer 必须与 IdP discovery 文档中的值完全一致（含末尾斜杠）；
#      redirect_url 必须是浏览器可达的外部地址，指向后端回调接口
# oidc:
#   enabled: true
#   issuer: https://idp.example.com/realms/main
#   client_id: mliev-push
#   client_secret: your-client-secret
#   redirect_url: https://push.example.com/api/admin/auth/oidc/callback
#   scopes: openid profile email
#   display_name: SSO 登录
#   frontend_callback: /auth/sso-callback
#   # 禁用用户名密码登录，仅允许 SSO（仅当 OIDC 配置完整可用时生效，防止把自己锁在门外）
#   disable_password_login: false

# 短链接配置
shortlink:
  domain: "http://localhost:8080"
  length: 6
  custom_length: true

# 限流配置
rate_limit:
  requests_per_minute: 100
  burst: 10

# CORS 配置
cors:
  allow_origins:
    - "*"
  allow_methods:
    - "GET"
    - "POST"
    - "PUT"
    - "DELETE"
    - "OPTIONS"
  allow_headers:
    - "Origin"
    - "Content-Type"
    - "Authorization" 