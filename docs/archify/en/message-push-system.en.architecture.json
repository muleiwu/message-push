    "views": [
      {
        "id": "api-entry",
        "label": "API & security entry",
        "focus": [
          "biz-app",
          "biz-form",
          "security-gate",
          "http-api",
          "admin-console"
        ],
        "note": "Public calls sign with HMAC; the admin console uses JWT or OIDC. The gate enforces rate limits, quotas, and replay protection."
      },
      {
        "id": "async-pipeline",
        "label": "Async delivery pipeline",
        "focus": [
          "http-api",
          "messaging",
          "queue-producer",
          "redis",
          "worker-pool"
        ],
        "note": "Tasks persist first, then enter Redis Streams or the scheduled ZSet; a consumer group delivers at-least-once with idempotent enqueue."
      },
      {
        "id": "provider-dispatch",
        "label": "Channel selection & dispatch",
        "focus": [
          "worker-pool",
          "message-handler",
          "sms-providers",
          "smtp-provider",
          "wecom-provider",
          "dingtalk-provider",
          "onebot-provider"
        ],
        "note": "Selection weighs priority groups, smooth weights, circuit state, and 5-minute provider memory before dispatching."
      },
      {
        "id": "receipts-and-rules",
        "label": "Receipts, rules & webhooks",
        "focus": [
          "callback-handler",
          "rule-engine",
          "relational-db",
          "biz-callback",
          "provider-polling"
        ],
        "note": "Receipts update task state; failure rules retry, switch providers, or alert; outcomes reach the business via webhook and polling."
      }
    ]
  },
