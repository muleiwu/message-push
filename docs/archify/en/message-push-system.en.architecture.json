  "cards": [
    {
      "dot": "rose",
      "title": "Security entry",
      "items": [
        "Public API signs requests with HMAC-SHA256 plus timestamp and nonce",
        "Admin API uses Bearer JWT with optional OIDC SSO; the gate adds rate limits, quotas, and body-size caps"
      ]
    },
    {
      "dot": "violet",
      "title": "Async reliability",
      "items": [
        "Redis Streams consumer groups deliver at-least-once; CAS updates prevent duplicate processing",
        "Scheduled ZSet, reclaimer, and dead-letter stream cover delay, crash, and permanent-failure paths"
      ]
    },
    {
      "dot": "emerald",
      "title": "Multi-channel HA",
      "items": [
        "Channel selection by priority and smooth weight with circuit state and 5-minute provider memory",
        "Failure rules support retry, provider switching, terminal failure, and alerts"
      ]
    }
  ]
