    "views": [
      {
        "id": "api-entry",
        "label": "API 与安全入口",
        "focus": [
          "biz-app",
          "biz-form",
          "security-gate",
          "http-api",
          "admin-console"
        ],
        "note": "业务调用走 HMAC 签名，管理后台走 JWT 或 OIDC；入口同时执行限流、配额与防重放控制。"
      },
      {
        "id": "async-pipeline",
        "label": "异步投递主链",
        "focus": [
          "http-api",
          "messaging",
          "queue-producer",
          "redis",
          "worker-pool"
        ],
        "note": "任务先持久化，再进入 Redis Streams 或定时 ZSet；消费者组以幂等入队提供至少一次投递。"
      },
      {
        "id": "provider-dispatch",
        "label": "通道选择与发送",
        "focus": [
          "worker-pool",
          "message-handler",
          "sms-providers",
          "smtp-provider",
          "wecom-provider",
          "dingtalk-provider",
          "onebot-provider"
        ],
        "note": "发送前综合优先级分组、平滑权重、熔断状态与 5 分钟供应商记忆选择通道。"
      },
      {
        "id": "receipts-and-rules",
        "label": "回执、规则与回调",
        "focus": [
          "callback-handler",
          "rule-engine",
          "relational-db",
          "biz-callback",
          "provider-polling"
        ],
        "note": "回执更新任务状态；失败规则重试、切换服务商或告警；结果经 Webhook 与轮询回传业务。"
      }
    ]
  },
