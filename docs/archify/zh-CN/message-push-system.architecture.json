  "cards": [
    {
      "dot": "rose",
      "title": "安全入口",
      "items": [
        "业务 API 使用 HMAC-SHA256 加时间戳与 nonce 验签",
        "管理 API 使用 Bearer JWT，可选 OIDC 单点登录；入口叠加限流、配额与请求体限制"
      ]
    },
    {
      "dot": "violet",
      "title": "异步可靠性",
      "items": [
        "Redis Streams 消费组提供至少一次投递，CAS 更新避免重复处理",
        "定时 ZSet、回收扫描与死信流覆盖延迟、崩溃与永久失败场景"
      ]
    },
    {
      "dot": "emerald",
      "title": "多通道高可用",
      "items": [
        "按优先级与平滑权重选择通道，结合熔断状态与 5 分钟供应商记忆",
        "失败规则支持重试、切换服务商、终止与告警"
      ]
    }
  ]
